Fix build with gawk >= 5.0, which reserves `namespace` as a keyword and
fails with: "gawk: fatal: cannot use gawk builtin `namespace' as
variable name". Rename the awk-level variable to `ns_prefix` in
mkstrtable.awk and in its callers (Makefile.am and the pre-generated
Makefile.in, so the build works whether or not autoreconf regenerates
Makefile.in).

--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -184,7 +184,7 @@

 errnos-sym.h: Makefile mkstrtable.awk errnos.in
 	$(AWK) -f $(srcdir)/mkstrtable.awk -v textidx=2 -v nogettext=1 \
-		-v prefix=GPG_ERR_ -v namespace=errnos_ \
+		-v prefix=GPG_ERR_ -v ns_prefix=errnos_ \
 		$(srcdir)/errnos.in >$@

 # We depend on versioninfo.rc because that is build by config.status
--- a/src/Makefile.in
+++ b/src/Makefile.in
@@ -1018,7 +1018,7 @@

 errnos-sym.h: Makefile mkstrtable.awk errnos.in
 	$(AWK) -f $(srcdir)/mkstrtable.awk -v textidx=2 -v nogettext=1 \
-		-v prefix=GPG_ERR_ -v namespace=errnos_ \
+		-v prefix=GPG_ERR_ -v ns_prefix=errnos_ \
 		$(srcdir)/errnos.in >$@

 # We depend on versioninfo.rc because that is build by config.status
--- a/src/mkstrtable.awk
+++ b/src/mkstrtable.awk
@@ -77,7 +77,7 @@
 #
 # The variable prefix can be used to prepend a string to each message.
 #
-# The variable namespace can be used to prepend a string to each
+# The variable ns_prefix can be used to prepend a string to each
 # variable and macro name.

 BEGIN {
@@ -102,7 +102,7 @@
       print "/* The purpose of this complex string table is to produce";
       print "   optimal code with a minimum of relocations.  */";
       print "";
-      print "static const char " namespace "msgstr[] = ";
+      print "static const char " ns_prefix "msgstr[] = ";
       header = 0;
     }
   else
@@ -150,7 +150,7 @@
   else
     print "  gettext_noop (\"" last_msgstr "\");";
   print "";
-  print "static const int " namespace "msgidx[] =";
+  print "static const int " ns_prefix "msgidx[] =";
   print "  {";
   for (i = 0; i < coded_msgs; i++)
     print "    " pos[i] ",";
@@ -158,7 +158,7 @@
   print "  };";
   print "";
   print "static GPG_ERR_INLINE int";
-  print namespace "msgidxof (int code)";
+  print ns_prefix "msgidxof (int code)";
   print "{";
   print "  return (0 ? 0";
